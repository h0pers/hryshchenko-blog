---
// A single post at /blog/<slug>/. Ported from blog/blog_post_page.html.
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ShareLinks from '@/components/ShareLinks.astro'
import site from '@/data/site.json'
import { getPublishedPosts } from '@/lib/posts'
import { formatDate, isoDate } from '@/lib/urls'

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content } = await render(post)
const { title, date, excerpt, tags, heroImage, seoTitle, description } = post.data
const fullUrl = new URL(Astro.url.pathname, Astro.site).href
---

<BaseLayout
  title={seoTitle ?? title}
  description={description ?? excerpt}
  image={heroImage}
  type="article"
  publishedTime={date}
>
  <article>
    <header>
      <div class="mx-auto max-w-3xl">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          &middot; {site.author}
        </p>
        <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tighter text-balance sm:text-5xl">
          {title}
        </h1>
        {tags.length > 0 && (
          <p class="mt-4 flex flex-wrap gap-x-4 text-sm text-muted-foreground">
            {tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </p>
        )}
        <ShareLinks title={title} url={fullUrl} />
      </div>
      {heroImage && (
        <figure class="mt-10">
          <Image src={heroImage} width={1400} alt={title} loading="eager" class="w-full object-cover" />
        </figure>
      )}
    </header>

    {excerpt && <p class="mx-auto mt-10 max-w-3xl text-lg leading-relaxed text-muted-foreground">{excerpt}</p>}

    <div class="prose mx-auto mt-10 max-w-3xl">
      <Content />
    </div>
  </article>
</BaseLayout>
