---
// GitHub Pages serves dist/404.html for any unknown path.
import BaseLayout from '@/layouts/BaseLayout.astro'
import { url } from '@/lib/urls'
---

<BaseLayout title="Page not found">
  <div class="py-24 text-center">
    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">404</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tighter">Page not found</h1>
    <a href={url('/')} class="mt-8 inline-block text-sm underline-offset-4 hover:underline">
      Back to home
    </a>
  </div>
</BaseLayout>
