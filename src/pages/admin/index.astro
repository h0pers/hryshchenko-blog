---
// Sveltia CMS admin at /admin/. A bare page on purpose: no site layout or
// styles, so nothing interferes with the CMS app, which mounts on <body>.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>hryshchenko - admin</title>
  </head>
  <body>
    <script>
      import { init } from '@sveltia/cms'
      import { cmsConfig } from '@/cms/config'

      init({ config: cmsConfig(new URL(import.meta.env.BASE_URL, window.location.origin).href) })
    </script>
  </body>
</html>
