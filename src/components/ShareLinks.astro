---
// Share-to-social links for a post. Replaces django-social-share: each
// network just takes the post URL (and title) as query parameters.
interface Props {
  title: string
  url: string
}

const { title, url } = Astro.props
const u = encodeURIComponent(url)
const t = encodeURIComponent(title)

const networks = [
  { label: 'X', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { label: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}` },
  { label: 'WhatsApp', href: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} ${url}`)}` },
  { label: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
]
---

<div class="mt-6 flex flex-wrap items-center gap-2">
  <span class="mr-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">Share:</span>
  {networks.map((network) => (
    <a
      href={network.href}
      target="_blank"
      rel="noopener"
      class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground transition-colors hover:border-foreground hover:text-foreground"
    >
      {network.label}
    </a>
  ))}
</div>
