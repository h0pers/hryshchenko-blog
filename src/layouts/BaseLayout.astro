---
// Site shell: header (logo, RSS, theme toggle), main column and footer.
// Ported from the Django templates/base.html.
import type { ComponentProps } from 'astro/types'
import Seo from '@/components/Seo.astro'
import RssLink from '@/islands/RssLink.vue'
import ThemeToggle from '@/islands/ThemeToggle.vue'
import site from '@/data/site.json'
import { feedUrl, url } from '@/lib/urls'
import '@/styles/style.css'

type Props = ComponentProps<typeof Seo>

const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...Astro.props} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={feedUrl} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <script is:inline>
      ;(function () {
        const root = document.documentElement
        root.classList.add('js')
        const stored = localStorage.getItem('theme')
        const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
        root.classList.toggle('dark', dark)
      })()
    </script>
    <style is:inline>
      #page-loader {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: none;
        align-items: center;
        justify-content: center;
        background: #ffffff;
      }
      .js #page-loader {
        display: flex;
      }
      .dark #page-loader {
        background: #1b1b1b;
      }
      #page-loader .page-loader-square {
        width: 1rem;
        height: 1rem;
        background: #000000;
      }
      .dark #page-loader .page-loader-square {
        background: #f5f5f5;
      }
    </style>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <div id="page-loader" aria-hidden="true">
      <span class="page-loader-square"></span>
    </div>
    <header class="sticky top-0 z-40 border-b border-border bg-background">
      <div class="mx-auto flex h-14 w-full max-w-3xl xl:max-w-5xl 2xl:max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href={url('/')} class="font-display text-lg font-semibold tracking-tight">
          hryshchenko
        </a>
        <div class="flex items-center gap-1">
          <RssLink url={url('/subscribe/')} />
          <div class="size-9">
            <ThemeToggle client:only="vue" />
          </div>
        </div>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl xl:max-w-5xl 2xl:max-w-6xl flex-1 px-4 py-12 sm:px-6">
      <slot />
    </main>
    <footer data-site-footer class="border-t border-border bg-background">
      <div class="mx-auto flex w-full max-w-3xl xl:max-w-5xl 2xl:max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-xs text-muted-foreground sm:px-6">
        <span>
          &copy; {year} {site.author}
        </span>
        <span class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {site.email && (
            <a href={`mailto:${site.email}`} class="underline-offset-4 hover:underline">
              {site.email}
            </a>
          )}
          {site.links.map((link) => (
            <a href={link.url} rel="me noopener" target="_blank" class="underline-offset-4 hover:underline">
              {link.label}
            </a>
          ))}
        </span>
      </div>
    </footer>
    <script>
      import '@/scripts/main.js'
    </script>
  </body>
</html>
